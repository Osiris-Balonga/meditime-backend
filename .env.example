NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST/meditime?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST/meditime?sslmode=require"
FRONTEND_ORIGINS="http://localhost:5173,http://localhost:3000"
# Random secret of at least 32 characters, shared by all API instances.
SESSION_SECRET=
# Default: lax locally, none in production (HTTPS required).
SESSION_SAME_SITE=
GOOGLE_CLIENT_ID=
# gmail for local SMTP, resend for HTTP delivery (default).
EMAIL_PROVIDER=resend
# Gmail account and its 16-character app password. Never commit these values.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Resend API key and authorized sender.
EMAIL_API_KEY=
EMAIL_FROM=
